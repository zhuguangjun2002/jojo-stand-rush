# Store text as LF in the repository, whatever the author's OS happens to do.
* text=auto eol=lf

# Batch files are the exception: cmd.exe chokes on LF-only line endings inside
# parenthesised blocks, so force CRLF on checkout. Do not "fix" this.
*.bat text eol=crlf
*.cmd text eol=crlf

# Opaque payloads — no diff, no merge, no line-ending games.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp3 binary
*.wav binary
*.lnk binary
*.pyc binary

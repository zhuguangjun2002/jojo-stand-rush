# Python bytecode: regenerated by the interpreter, never worth a commit.
__pycache__/
*.py[cod]

# Local virtualenvs — every machine rebuilds its own.
.venv/
venv/

# Windows Explorer and macOS housekeeping noise.
Thumbs.db
desktop.ini
.DS_Store

# Editor state, kept out so nobody fights over workspace settings.
.vscode/
.idea/
*.swp

# Scratch screenshots: the "_" prefix marks throwaway captures used while
# tweaking the canvas renderer. The numbered ones are referenced by README.md.
screenshots/_*.png

# Logs and local server artifacts.
*.log

# Deployment scratch / local package managers.
dist/
.wrangler/
node_modules/

# Release archives are generated, not source.
*.zip
